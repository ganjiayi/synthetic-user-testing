{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persona v4 Library",
  "description": "Schema for the v4 Malaysian consumer persona library used in synthetic UX testing sessions.",
  "type": "object",
  "required": ["personas"],
  "properties": {
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slug", "name", "age", "archetype", "tagline", "identity", "personality", "streaming_behaviour", "motivations", "pain_points", "decision_making", "technology_literacy"],
        "properties": {
          "id":        { "type": "string" },
          "slug":      { "type": "string", "description": "URL-safe identifier used as persona_library_ref" },
          "name":      { "type": "string" },
          "age":       { "type": "integer" },
          "archetype": { "type": "string" },
          "tagline":   { "type": "string" },

          "identity": {
            "type": "object",
            "properties": {
              "location":             { "type": "string" },
              "role":                 { "type": "string" },
              "education":            { "type": "string" },
              "household_income_myr": {},
              "ethnicity":            { "type": "string" },
              "languages":            { "type": "array", "items": { "type": "string" } },
              "living_situation":     { "type": "string" },
              "primary_device":       { "type": "string" }
            }
          },

          "personality": {
            "type": "object",
            "properties": {
              "temperament":         { "type": "string" },
              "communication_style": { "type": "string" },
              "openness_to_change":  { "type": "string" },
              "social_orientation":  { "type": "string" }
            }
          },

          "streaming_behaviour": {
            "type": "object",
            "properties": {
              "platform_stack":     { "type": "array", "items": { "type": "string" } },
              "ad_tolerance":       { "type": "string" },
              "subscription_count": {},
              "payment_method":     { "type": "string" },
              "astro_relationship": { "type": "string" }
            }
          },

          "motivations":        { "type": "array", "items": { "type": "string" } },
          "success_definition": { "type": "string" },
          "pain_points":        { "type": "array", "items": { "type": "string" } },
          "signature_quotes":   { "type": "array", "items": { "type": "string" } },
          "idiosyncrasies":     { "type": "array", "items": { "type": "string" } },

          "decision_making": {
            "type": "object",
            "properties": {
              "info_gathering": { "type": "array", "items": { "type": "string" } },
              "risk_tolerance": { "type": "string" },
              "trust_signals":  { "type": "array", "items": { "type": "string" } },
              "dealbreakers":   { "type": "array", "items": { "type": "string" } }
            }
          },

          "behavioural_tendencies": { "type": "array", "items": { "type": "string" } },

          "technology_literacy": {
            "type": "object",
            "properties": {
              "overall_score":          { "type": "integer", "minimum": 0, "maximum": 100 },
              "app_navigation":         { "type": "integer" },
              "settings_comfort":       { "type": "integer" },
              "self_service_ratio":     { "type": "integer" },
              "complex_flow_tolerance": { "type": "integer" },
              "strengths":              { "type": "array", "items": { "type": "string" } },
              "weaknesses":             { "type": "array", "items": { "type": "string" } },
              "learning_style":         { "type": "string" },
              "device_competency":      { "type": "object" }
            }
          },

          "ux_change_response": {
            "type": "object",
            "properties": {
              "ui_redesign":             { "type": "string" },
              "new_feature_discovery":   { "type": "string" },
              "complex_flow_behaviour":  { "type": "string" },
              "error_states":            { "type": "string" },
              "design_signals":          { "type": "array", "items": { "type": "string" } }
            }
          },

          "astro_pain_points": {
            "type": "object",
            "properties": {
              "relationship_type": { "type": "string" },
              "applicable_issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "theme":       { "type": "string" },
                    "severity":    { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
                    "status":      { "type": "string" },
                    "description": { "type": "string" },
                    "voice":       { "type": "string" }
                  }
                }
              },
              "churn_type": { "type": "string" },
              "churn_risk": { "type": "string" }
            }
          },

          "limitations": { "type": "object" }
        }
      }
    }
  }
}
