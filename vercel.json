{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "ui/build",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/runs/[id]/plan.js":     { "maxDuration": 300 },
    "api/runs/[id]/evaluate.js": { "maxDuration": 300 }
  }
}
