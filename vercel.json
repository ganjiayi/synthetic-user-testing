{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "ui/build",
  "routes": [
    { "src": "/api/health",                                  "dest": "/api/health.js" },
    { "src": "/api/runs/([^/]+)/plan",                       "dest": "/api/runs/[id]/plan.js?id=$1" },
    { "src": "/api/runs/([^/]+)/evaluate",                   "dest": "/api/runs/[id]/evaluate.js?id=$1" },
    { "src": "/api/runs/([^/]+)/sessions",                   "dest": "/api/runs/[id]/sessions.js?id=$1" },
    { "src": "/api/runs/([^/]+)/status",                     "dest": "/api/runs/[id]/status.js?id=$1" },
    { "src": "/api/runs/([^/]+)/upload",                     "dest": "/api/runs/[id]/upload.js?id=$1" },
    { "src": "/api/runs/([^/]+)/report",                     "dest": "/api/runs/[id]/report.js?id=$1" },
    { "src": "/api/runs/([^/]+)/materials/([^/]+)",          "dest": "/api/runs/[id]/materials/[file].js?id=$1&file=$2" },
    { "src": "/api/runs/([^/]+)/download/([^/]+)",           "dest": "/api/runs/[id]/download/[file].js?id=$1&file=$2" },
    { "src": "/api/runs/([^/]+)",                            "dest": "/api/runs/[id]/index.js?id=$1" },
    { "src": "/api/runs",                                    "dest": "/api/runs/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)",                                        "dest": "/index.html" }
  ],
  "functions": {
    "api/runs/[id]/plan.js":     { "maxDuration": 300 },
    "api/runs/[id]/evaluate.js": { "maxDuration": 300 }
  }
}
